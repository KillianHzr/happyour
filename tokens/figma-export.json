{
  "primitives": {
    "color": {
      "blue": { "$type": "color", "$value": "#0d99ff" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#1e1e1e" }
    },
    "spacing": {
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "16px" }
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "primary": {
          "$type": "color",
          "$value": {
            "light": "{primitives.color.white}",
            "dark": "{primitives.color.black}"
          }
        }
      },
      "text": {
        "main": {
          "$type": "color",
          "$value": {
            "light": "{primitives.color.black}",
            "dark": "{primitives.color.blue}"
          }
        }
      }
    }
  },
  "composite": {
    "typography": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": "Regular",
          "fontSize": "16px"
        }
      }
    },
    "shadow": {
      "card": {
        "$type": "shadow",
        "$value": {
          "color": "#000000",
          "opacity": 0.1,
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px"
        }
      }
    }
  }
}
