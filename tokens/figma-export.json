{
  "primitives": {
    "color": {
      "blue": { "$type": "color", "$value": "#0d99ff" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#1e1e1e" },
      "gray": { "$type": "color", "$value": "#f5f5f5" },
      "darkGray": { "$type": "color", "$value": "#2c2c2c" }
    },
    "dimension": {
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "16px" }
    }
  },
  "semantic": {
    "color": {
      "background": {
        "primary": {
          "$type": "color",
          "$value": {
            "light": "{primitives.color.white}",
            "dark": "{primitives.color.black}"
          }
        },
        "secondary": {
          "$type": "color",
          "$value": {
            "light": "{primitives.color.gray}",
            "dark": "{primitives.color.darkGray}"
          }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": {
            "light": "{primitives.color.black}",
            "dark": "{primitives.color.white}"
          }
        },
        "brand": {
          "$type": "color",
          "$value": {
            "light": "{primitives.color.blue}",
            "dark": "{primitives.color.blue}"
          }
        }
      }
    }
  },
  "composite": {
    "typography": {
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 700,
          "fontSize": "{primitives.dimension.md}",
          "lineHeight": 1.2
        }
      }
    },
    "shadow": {
      "elevation": {
        "$type": "shadow",
        "$value": {
          "color": "#000000",
          "opacity": 0.15,
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        }
      }
    }
  }
}
